### Coffee Management API Test Requests

# ==================== AUTH ====================

### Register new user
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123",
  "fullName": "John Doe"
}

### Login
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123"
}

# ==================== PRODUCTS ====================

### Get all products
GET http://localhost:3000/api/products

### Get product by ID
GET http://localhost:3000/api/products/1

### Get products by category
GET http://localhost:3000/api/products/category/coffee

### Create product (Admin only)
POST http://localhost:3000/api/products
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "name": "Espresso",
  "price": 2.50,
  "category": "coffee",
  "description": "Strong black coffee",
  "image": "https://example.com/espresso.jpg"
}

### Update product (Admin only)
PUT http://localhost:3000/api/products/1
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "name": "Cappuccino",
  "price": 3.50,
  "category": "coffee",
  "description": "Creamy coffee with milk",
  "image": "https://example.com/cappuccino.jpg"
}

### Delete product (Admin only)
DELETE http://localhost:3000/api/products/1
Authorization: Bearer YOUR_JWT_TOKEN

# ==================== ORDERS ====================

### Get all orders (Admin only)
GET http://localhost:3000/api/orders
Authorization: Bearer YOUR_ADMIN_TOKEN

### Get my orders
GET http://localhost:3000/api/orders/user/my-orders
Authorization: Bearer YOUR_JWT_TOKEN

### Get order by ID
GET http://localhost:3000/api/orders/1
Authorization: Bearer YOUR_JWT_TOKEN

### Create order
POST http://localhost:3000/api/orders
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "items": [
    {
      "productId": 1,
      "productName": "Espresso",
      "quantity": 2,
      "price": 2.50
    },
    {
      "productId": 2,
      "productName": "Cake",
      "quantity": 1,
      "price": 5.00
    }
  ],
  "totalPrice": 10.00
}

### Update order status (Admin only)
PUT http://localhost:3000/api/orders/1/status
Content-Type: application/json
Authorization: Bearer YOUR_ADMIN_TOKEN

{
  "status": "completed"
}

### Cancel order
PUT http://localhost:3000/api/orders/1/cancel
Authorization: Bearer YOUR_JWT_TOKEN

# ==================== USERS ====================

### Get all users (Admin only)
GET http://localhost:3000/api/users
Authorization: Bearer YOUR_ADMIN_TOKEN

### Get my profile
GET http://localhost:3000/api/users/profile/me
Authorization: Bearer YOUR_JWT_TOKEN

### Get user by ID (Admin only)
GET http://localhost:3000/api/users/1
Authorization: Bearer YOUR_ADMIN_TOKEN

### Update my profile
PUT http://localhost:3000/api/users/profile/update
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "fullName": "John Doe Updated",
  "phone": "0123456789",
  "address": "123 Main St, City"
}
